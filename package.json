{
  "name": "3-am-philosophy",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "One button, strange philosophical questions, and branching rabbit holes.",
  "engines": {
    "node": "^22.13.0 || ^24.0.0",
    "npm": ">=10 <12"
  },
  "packageManager": "npm@10.9.2",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsc -b && eslint . --max-warnings=0 && prettier . --check && vitest run && vite build"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.12.0",
    "prettier": "3.9.8",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.70.1",
    "vite": "^8.3.0",
    "vitest": "5.0.1"
  }
}
